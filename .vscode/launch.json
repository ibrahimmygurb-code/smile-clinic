{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "تشغيل المشروع",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "فتح الموقع",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "تشغيل وفتح الموقع",
      "configurations": ["تشغيل المشروع", "فتح الموقع"],
      "stopAll": true
    }
  ]
}
