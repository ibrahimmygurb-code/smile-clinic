generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  confirmed
  cancelled
}

model Booking {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  phone       String
  serviceId   String
  serviceName String
  duration    Int
  price       Int
  date        String
  time        String
  status      BookingStatus  @default(confirmed)
  createdAt   DateTime       @default(now())

  @@index([date, status])
  @@map("bookings")
}
